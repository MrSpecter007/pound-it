# Django project
/alternative_naissance/media/
/static/
*.sqlite3

# Database dumps must never enter the image. dump.sql and
# backup_before_home.sql sit inside the copied application directory and carry
# auth_user password hashes plus the core_inscription table (names, emails,
# postal addresses, phone numbers).
*.sql
*.dump
*.sql.gz

